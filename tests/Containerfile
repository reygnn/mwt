# What `make evil` runs in: mwt's and mwc's build dependencies and the test tools,
# clang with libFuzzer for make fuzz too; git: -v and XTVERSION name the commit
# built. Arch, as the host and as mwc's own image: mwc needs wlroots 0.20.
FROM docker.io/library/archlinux:latest
RUN pacman -Syu --noconfirm --needed \
    base-devel pkgconf wayland wayland-protocols \
    libxkbcommon freetype2 fontconfig ncurses \
    cairo pango \
    sway wtype wl-clipboard grim python vim tmux \
    ttf-dejavu procps-ng xkeyboard-config \
    wlroots0.20 libxcb xcb-util-wm libx11 pixman \
    clang compiler-rt git \
    && pacman -Scc --noconfirm
# Arch's sway has cap_sys_nice, which a rootless container cannot give: exec fails.
RUN setcap -r /usr/bin/sway
RUN useradd -m tester
USER tester
WORKDIR /home/tester
