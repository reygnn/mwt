# What `make evil` runs in: mwt's and mwc's build dependencies and the test tools.
FROM docker.io/library/ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config libwayland-dev wayland-protocols \
    libxkbcommon-dev libfreetype-dev libfontconfig-dev ncurses-bin \
    libcairo2-dev libpango1.0-dev \
    sway wtype wl-clipboard grim python3 \
    fonts-dejavu-core fontconfig procps xkb-data locales \
    libwlroots-0.19-dev libxcb1-dev libxcb-icccm4-dev libx11-dev libpixman-1-dev
RUN useradd -m tester
USER tester
WORKDIR /home/tester
