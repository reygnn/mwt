! paper: for daylight, dark brown-grey on cream like an e-reader (11:1). On a
! light background the bright colors are darker than the normal ones, so bold
! text stands out instead of fading; color7 and color15 are dark too, and
! every text color is at least 4.6:1.
Mwt*paper*foreground:              #38322b
Mwt*paper*background:              #f6efe3
Mwt*paper*cursorColor:             #38322b
Mwt*paper*selectionForeground:     #38322b
Mwt*paper*selectionBackground:     #dfd3bb
