Mwt*dracula*background:            #282a36
Mwt*dracula*cursorColor:           #eaeae2
Mwt*dracula*selectionForeground:   #eaeae2
Mwt*dracula*selectionBackground:   #44475a
Mwt*dracula*color0:                #21222c
