! doc/mwtrc: an example; copy it to ~/.config/mwt/mwtrc. mwt reads it at startup,
! over the colors of config.h.
! Try with: mwt -a indigo3  /  mwt -a dracula  /  mwt -a paper  /  mwt -a amber

! indigo3, after the SGI IRIS Indigo winterm: its blue a little lifted (12:1
! instead of 15.5:1), off-white text, a palette with even lightness in OKLCH;
! every text color at least 5:1 on the background, red and green apart in
! lightness for red-green color blindness.
Mwt*indigo3*foreground:            #d8dbe0
Mwt*indigo3*background:            #111c40
Mwt*indigo3*cursorColor:           #d8dbe0
Mwt*indigo3*selectionForeground:   #d8dbe0
Mwt*indigo3*selectionBackground:   #354573
Mwt*indigo3*color0:                #2e3750
Mwt*indigo3*color1:                #d97e77
Mwt*indigo3*color2:                #97c98c
Mwt*indigo3*color3:                #dbb970
Mwt*indigo3*color4:                #88bbe0
Mwt*indigo3*color5:                #c78fc1
Mwt*indigo3*color6:                #84c9c8
Mwt*indigo3*color7:                #bec1c8
Mwt*indigo3*color8:                #878fa2
Mwt*indigo3*color9:                #ef9a93
Mwt*indigo3*color10:               #b4e1aa
Mwt*indigo3*color11:               #f2d494
Mwt*indigo3*color12:               #a9d4f3
Mwt*indigo3*color13:               #ddabd7
Mwt*indigo3*color14:               #a8e1e0
Mwt*indigo3*color15:               #e6e8ec

! dracula: Dracula (draculatheme.com) softened, same hues: less saturated
