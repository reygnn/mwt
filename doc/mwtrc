Mwt*paper*color11:                 #735601
Mwt*paper*color12:                 #004c86
Mwt*paper*color13:                 #6b1f68
Mwt*paper*color14:                 #076262
Mwt*paper*color15:                 #26201a

! amber: amber phosphor on dark brown, as on DEC and Wyse terminals (10.7:1).
! One family of hues, no blue; the 16 colors differ mostly in lightness, from
! orange-red to pale yellow, so ls and diff colors are harder to tell apart.
Mwt*amber*foreground:              #f6b663
